{
  "name": "packed_ascii_decoder",
  "size": "24x4",
  "interior": [
    ">@rsrbd              >rv",
    "      >`8`M+*Mr/sWsmd^  ",
    "      ^             <   ",
    "^                      <"
  ],
  "ports": {
    "bytes": {
      "type": "output",
      "side": "top",
      "offset_range": [
        18,
        18
      ],
      "length_range": [
        2,
        64
      ]
    },
    "rom": {
      "type": "input",
      "side": "top",
      "offset_range": [
        2,
        2
      ],
      "length_range": [
        2,
        64
      ]
    },
    "state_in": {
      "type": "input",
      "side": "top",
      "offset_range": [
        15,
        15
      ],
      "length_range": [
        2,
        64
      ]
    },
    "state_out": {
      "type": "output",
      "side": "top",
      "offset_range": [
        16,
        16
      ],
      "length_range": [
        2,
        64
      ]
    }
  },
  "tests": [
    {
      "name": "one_word",
      "inputs": {
        "rom": [
          1106241,
          3
        ]
      },
      "expected": {
        "bytes": [
          65,
          66,
          67
        ]
      },
      "loopbacks": {
        "state_out": "state_in"
      }
    },
    {
      "name": "two_words",
      "inputs": {
        "rom": [
          1106241,
          3,
          15608,
          2
        ]
      },
      "expected": {
        "bytes": [
          65,
          66,
          67,
          120,
          121
        ]
      },
      "loopbacks": {
        "state_out": "state_in"
      }
    }
  ]
}
