{
  "name": "Mirrored minimal one-value FIFO relay",
  "size": "5x2",
  "interior": [
    "vsr@<",
    ">   ^"
  ],
  "ports": {
    "input": {
      "type": "input",
      "side": "top",
      "offset_range": [2, 2],
      "length_range": [2, 64]
    },
    "output": {
      "type": "output",
      "side": "left",
      "offset_range": [1, 1],
      "length_range": [2, 64]
    }
  },
  "tests": [
    {
      "name": "relays values unchanged",
      "inputs": {
        "input": [0, 42, -17, 1000000]
      },
      "expected": {
        "output": [0, 42, -17, 1000000]
      }
    }
  ]
}
