{
  "name": "packed_result_router",
  "size": "11x6",
  "interior": [
    "   >`0`  v ",
    "           ",
    ">@rXrsrs >v",
    "           ",
    "   >rs   ^ ",
    "^         <"
  ],
  "ports": {
    "replacement": {
      "type": "output",
      "side": "top",
      "offset_range": [
        5,
        5
      ],
      "length_range": [
        2,
        64
      ]
    },
    "response": {
      "type": "output",
      "side": "top",
      "offset_range": [
        7,
        7
      ],
      "length_range": [
        2,
        64
      ]
    },
    "result": {
      "type": "input",
      "side": "top",
      "offset_range": [
        4,
        4
      ],
      "length_range": [
        2,
        64
      ]
    }
  },
  "tests": [
    {
      "name": "mixed",
      "inputs": {
        "result": [
          0,
          100,
          -7,
          1,
          200,
          0,
          300,
          42
        ]
      },
      "expected": {
        "replacement": [
          100,
          200,
          300
        ],
        "response": [
          -7,
          42
        ]
      }
    }
  ]
}
