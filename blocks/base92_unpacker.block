{
  "name": "Compact base-92 word unpacker",
  "size": "28x4",
  "interior": [
    "                            ",
    ">@rM8bW>M`92 `W/WsWmdsv     ",
    "       ^            < v     ",
    "^                     <     "
  ],
  "ports": {
    "rom": {
      "type": "input",
      "side": "top",
      "offset_range": [3, 3],
      "length_range": [2, 64]
    },
    "codes": {
      "type": "output",
      "side": "right",
      "offset_range": [1, 1],
      "length_range": [2, 64]
    }
  },
  "tests": [
    {
      "name": "full_word",
      "inputs": {
        "rom": [383883966249096266]
      },
      "expected": {
        "codes": [18, 26, 26, 23, 27, 1, 49, 73, 74]
      }
    },
    {
      "name": "final_word",
      "inputs": {
        "rom": [3095]
      },
      "expected": {
        "codes": [59, 33, 0, 0, 0, 0, 0, 0, 0]
      }
    }
  ]
}
