{
  "name": "history_huffman_code_relay",
  "size": "3x2",
  "interior": [
    "\u003e@v",
    "^sU"
  ],
  "ports": {
    "in": {
      "type": "input",
      "side": "right",
      "offset_range": [
        1,
        1
      ],
      "length_range": [
        2,
        4096
      ]
    },
    "out": {
      "type": "output",
      "side": "bottom",
      "offset_range": [
        0,
        0
      ],
      "length_range": [
        2,
        4096
      ]
    }
  },
  "tests": [
    {
      "name": "relay",
      "inputs": {
        "in": [
          0,
          42,
          125
        ]
      },
      "expected": {
        "out": [
          0,
          42,
          125
        ]
      }
    }
  ]
}
