{
  "name": "100-cell raw-request ring engine",
  "size": "24x14",
  "interior": [
    ">@rX`99`MrbN+s0M  v",
    "   v              v",
    "   >`99`MrbN+s1M  v",
    "                  v   <",
    "                  arsm^",
    "                  >WXrsv",
    "     vMr            <",
    "  vs                   <",
    "     >             rWs v",
    "  v                    <",
    "  >         rb    v",
    "                  v   <",
    "                  arsm^",
    "^                 <"
  ],
  "ports": {
    "request": {
      "type": "input",
      "side": "left",
      "offset_range": [0, 0],
      "length_range": [2, 64]
    },
    "in_ring": {
      "type": "input",
      "side": "top",
      "offset_range": [19, 19],
      "length_range": [100, 256]
    },
    "out_ring": {
      "type": "output",
      "side": "right",
      "offset_range": [8, 8],
      "length_range": [2, 64]
    },
    "response": {
      "type": "output",
      "side": "left",
      "offset_range": [9, 9],
      "length_range": [2, 64]
    },
    "scratch_out": {
      "type": "output",
      "side": "top",
      "offset_range": [13, 13],
      "length_range": [2, 64]
    },
    "scratch_in": {
      "type": "input",
      "side": "bottom",
      "offset_range": [1, 1],
      "length_range": [2, 64]
    }
  },
  "tests": [
