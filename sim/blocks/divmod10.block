{
  "name": "Address divmod 10",
  "size": "18x2",
  "interior": [
    "@`10`M>r/sWs`10`Mv",
    "      ^          <"
  ],
  "ports": {
    "in": {
      "type": "input",
      "side": "bottom",
      "offset_range": [7, 7],
      "length_range": [2, 64]
    },
    "out": {
      "type": "output",
      "side": "bottom",
      "offset_range": [10, 10],
      "length_range": [2, 64]
    }
  },
  "tests": [
    {
      "name": "all decimal regions",
      "inputs": {
        "in": [0, 9, 10, 42, 99]
      },
      "expected": {
        "out": [0, 0, 0, 9, 1, 0, 4, 2, 9, 9]
      }
    }
  ]
}
