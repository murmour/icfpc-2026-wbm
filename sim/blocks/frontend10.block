{
  "name": "Memory request frontend",
  "size": "17x17",
  "interior": [
    "@>rX`10`Mr/S0SWSv",
    "   `             ",
    "   1             ",
    "   0             ",
    "   `             ",
    "   M             ",
    "   r             ",
    "   /             ",
    "   S             ",
    "   1             ",
    "   S             ",
    "   W             ",
    "   S             ",
    "   r             ",
    "   S     >rv     ",
    "   >     ^      <",
    " ^         <     "
  ],
  "ports": {
    "in": {
      "type": "input",
      "side": "top",
      "offset_range": [2, 2],
      "length_range": [2, 64]
    },
    "ack": {
      "type": "input",
      "side": "right",
      "offset_range": [14, 14],
      "length_range": [2, 128]
    },
    "out_a": {
      "type": "output",
      "side": "right",
      "offset_range": [3, 3],
      "length_range": [2, 64]
    },
    "out_b": {
      "type": "output",
      "side": "bottom",
      "offset_range": [11, 11],
      "length_range": [2, 64]
    }
  },
  "tests": [
    {
      "name": "read and write framing",
      "inputs": {
        "in": [0, 3, 1, 42, -7, 0, 99],
        "ack": [0, 0, 0]
      },
      "expected": {
        "out_a": [0, 0, 3, 4, 1, 2, -7, 9, 0, 9],
        "out_b": [0, 0, 3, 4, 1, 2, -7, 9, 0, 9]
      }
    }
  ]
}
