{
  "name": "FIFO memory controller",
  "size": "45x20",
  "interior": [
    "@`1000001`M>rXrbv                            ",
    "             r                               ",
    "           s b                               ",
    "           ^                             <   ",
    "           vr                       <        ",
    "                                             ",
    "                >     >   drs             sv ",
    "                          r                  ",
    "                          s                  ",
    "                          m                  ",
    "                      ^   <                  ",
    "             >        >   dr        ^        ",
    "                          r                  ",
    "                          s                  ",
    "                          m                  ",
    "                      ^   <                  ",
    "                      v   <                  ",
    "                      >rs-X              ^   ",
    "                      ^        <           < ",
    "           >                  s^             "
  ],
  "ports": {
    "request": {
      "type": "input",
      "side": "top",
      "offset_range": [12, 12],
      "length_range": [2, 128]
    },
    "memory_in": {
      "type": "input",
      "side": "bottom",
      "offset_range": [22, 22],
      "length_range": [2, 128]
    },
    "output": {
      "type": "output",
      "side": "right",
      "offset_range": [6, 6],
      "length_range": [2, 128]
    },
    "memory_out": {
      "type": "output",
      "side": "bottom",
      "offset_range": [30, 30],
      "length_range": [2, 128]
    },
    "ack": {
      "type": "output",
      "side": "top",
      "offset_range": [11, 11],
      "length_range": [2, 128]
    }
  },
  "tests": []
}
