{
  "name": "Packed three-cell word codec, lane one",
  "size": "64x7",
  "interior": [
    "v                                              s}{W`34`M}W`12`M<",
    "v                                                              ^",
    "v                                                              ^",
    ">>@rXr                                                s        ^",
    " ^  v                                                          ",
    " ^  >rs`4398044413952`NM1W-Mr&srM`2097151`W&M`21`W{Mr|s        v",
    " ^                                                             <"
  ],
  "ports": {
    "request": {
      "type": "input",
      "side": "top",
      "offset_range": [4, 4],
      "length_range": [2, 64]
    },
    "value": {
      "type": "input",
      "side": "bottom",
      "offset_range": [31, 31],
      "length_range": [2, 64]
    },
    "scratch_word_in": {
      "type": "input",
      "side": "bottom",
      "offset_range": [27, 27],
      "length_range": [2, 64]
    },
    "scratch_cleared_in": {
      "type": "input",
      "side": "bottom",
      "offset_range": [51, 51],
      "length_range": [2, 64]
    },
    "replacement": {
      "type": "output",
      "side": "right",
      "offset_range": [3, 3],
      "length_range": [2, 64]
    },
    "response": {
      "type": "output",
      "side": "top",
      "offset_range": [47, 47],
      "length_range": [2, 64]
    },
    "scratch_word_out": {
      "type": "output",
      "side": "bottom",
      "offset_range": [15, 15],
      "length_range": [2, 64]
    },
    "scratch_cleared_out": {
      "type": "output",
      "side": "bottom",
      "offset_range": [38, 38],
      "length_range": [2, 64]
    }
  },
  "tests": [
    {
      "name": "read negative lane one",
      "inputs": {
        "request": [0, 4398031831040]
      },
      "expected": {
        "replacement": [4398031831040],
        "response": [-7],
        "scratch_word_out": [],
        "scratch_cleared_out": []
      }
    },
    {
      "name": "write lane one preserving lane zero",
      "inputs": {
        "request": [1, 42],
        "value": [-7]
      },
      "loopbacks": {
        "scratch_word_out": "scratch_word_in",
        "scratch_cleared_out": "scratch_cleared_in"
      },
      "expected": {
        "replacement": [4398031831082],
        "response": []
      }
    }
  ]
}
