{
  "name": "Packed three-cell word codec, lane two",
  "size": "64x7",
  "interior": [
    "v                                              s}{W`34`M}W`24`M<",
    "v                                                              ^",
    "v                                                              ^",
    ">>@rXr                                                      s  ^",
    " ^  v                                                          ",
    " ^  >rs`9223367638808264704`NM1W-Mr&srM`2097151`W&M`42`W{Mr|s  v",
    " ^                                                             <"
  ],
  "ports": {
    "request": {
      "type": "input",
      "side": "top",
      "offset_range": [4, 4],
      "length_range": [2, 64]
    },
    "value": {
      "type": "input",
      "side": "bottom",
      "offset_range": [37, 37],
      "length_range": [2, 64]
    },
    "scratch_word_in": {
      "type": "input",
      "side": "bottom",
      "offset_range": [33, 33],
      "length_range": [2, 64]
    },
    "scratch_cleared_in": {
      "type": "input",
      "side": "bottom",
      "offset_range": [57, 57],
      "length_range": [2, 64]
    },
    "replacement": {
      "type": "output",
      "side": "right",
      "offset_range": [3, 3],
      "length_range": [2, 64]
    },
    "response": {
      "type": "output",
      "side": "top",
      "offset_range": [47, 47],
      "length_range": [2, 64]
    },
    "scratch_word_out": {
      "type": "output",
      "side": "bottom",
      "offset_range": [17, 17],
      "length_range": [2, 64]
    },
    "scratch_cleared_out": {
      "type": "output",
      "side": "bottom",
      "offset_range": [44, 44],
      "length_range": [2, 64]
    }
  },
  "tests": [
    {
      "name": "read negative lane two",
      "inputs": {
        "request": [0, 9223341250529198080]
      },
      "expected": {
        "replacement": [9223341250529198080],
        "response": [-7],
        "scratch_word_out": [],
        "scratch_cleared_out": []
      }
    },
    {
      "name": "write lane two preserving lane zero",
      "inputs": {
        "request": [1, 42],
        "value": [-7]
      },
      "loopbacks": {
        "scratch_word_out": "scratch_word_in",
        "scratch_cleared_out": "scratch_cleared_in"
      },
      "expected": {
        "replacement": [9223341250529198122],
        "response": []
      }
    }
  ]
}
