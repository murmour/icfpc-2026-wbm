{
  "name": "base99_unpacker",
  "size": "21x3",
  "interior": [
    ">@r    >M `99`W/WsWXv",
    "       ^           <v",
    "^                   <"
  ],
  "ports": {
    "codes": {
      "type": "output",
      "side": "bottom",
      "offset_range": [
        20,
        20
      ],
      "length_range": [
        2,
        4096
      ]
    },
    "rom": {
      "type": "input",
      "side": "left",
      "offset_range": [
        1,
        1
      ],
      "length_range": [
        2,
        4096
      ]
    }
  },
  "tests": [
    {
      "name": "eight_codes",
      "inputs": {
        "rom": [
          4701155549599972
        ]
      },
      "expected": {
        "codes": [
          1,
          8,
          15,
          22,
          29,
          36,
          43,
          50
        ]
      }
    },
    {
      "name": "nine_codes_with_zero",
      "inputs": {
        "rom": [
          9885589505381899
        ]
      },
      "expected": {
        "codes": [
          1,
          0,
          2,
          3,
          4,
          5,
          6,
          7,
          1
        ]
      }
    }
  ]
}
