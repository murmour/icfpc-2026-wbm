{
  "name": "Single register memory cell",
  "size": "8x7",
  "interior": [
    ">@rXWsWv",
    "   r   v",
    "   W   v",
    "   0   v",
    "   s   v",
    "   >   v",
    "^......<"
  ],
  "ports": {
    "request": {
      "type": "input",
      "side": "bottom",
      "offset_range": [2, 2],
      "length_range": [2, 64]
    },
    "response": {
      "type": "output",
      "side": "bottom",
      "offset_range": [5, 5],
      "length_range": [2, 64]
    }
  },
  "tests": [
    {
      "name": "initial read, writes, and repeated reads",
      "inputs": {
        "request": [0, 1, 42, 0, 0, 1, -17, 0, 1, 0, 0]
      },
      "expected": {
        "response": [0, 0, 42, 42, 0, -17, 0, 0]
      }
    }
  ]
}
