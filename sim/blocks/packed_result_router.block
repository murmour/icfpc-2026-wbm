{
  "name": "packed_result_router",
  "size": "21x14",
  "interior": [
    "     >`0`          v ",
    "                     ",
    ">@v >Xv >v >v >v > >v",
    "  >r^ >r^>s^>r^      ",
    "                     ",
    "                     ",
    "                     ",
    "                     ",
    "                     ",
    "               >s^   ",
    "                     ",
    "     >v >v >       ^ ",
    "      >r^>s^         ",
    "^                   <"
  ],
  "ports": {
    "replacement": {
      "type": "output",
      "side": "bottom",
      "offset_range": [
        10,
        10
      ],
      "length_range": [
        2,
        64
      ]
    },
    "response": {
      "type": "output",
      "side": "bottom",
      "offset_range": [
        16,
        16
      ],
      "length_range": [
        2,
        64
      ]
    },
    "result": {
      "type": "input",
      "side": "top",
      "offset_range": [
        7,
        7
      ],
      "length_range": [
        2,
        64
      ]
    }
  },
  "tests": [
    {
      "name": "mixed",
      "inputs": {
        "result": [
          0,
          100,
          -7,
          1,
          200,
          0,
          300,
          42
        ]
      },
      "expected": {
        "replacement": [
          100,
          200,
          300
        ],
        "response": [
          -7,
          42
        ]
      }
    }
  ]
}
