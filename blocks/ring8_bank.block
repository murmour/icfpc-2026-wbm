{
  "name": "Compact normalized eight-cell ring bank",
  "size": "14x9",
  "interior": [
    ">@rbrM   v   <",
    "         arsm^",
    "         W",
    "  vs srmbXNbmv",
    "  vvMr       <",
    "  v>      rWsv",
    "  >------v   <",
    "         arsm^",
    "^        <"
  ],
  "ports": {
    "request": {
      "type": "input",
      "side": "top",
      "offset_range": [1, 1],
      "length_range": [2, 64]
    },
    "in_ring": {
      "type": "input",
      "side": "top",
      "offset_range": [10, 10],
      "length_range": [8, 64]
    },
    "out_ring": {
      "type": "output",
      "side": "top",
      "offset_range": [7, 7],
      "length_range": [2, 64]
    },
    "response": {
      "type": "output",
      "side": "left",
      "offset_range": [3, 3],
      "length_range": [2, 64]
    }
  },
  "tests": [
    {
      "name": "read first cell",
      "inputs": {
        "request": [0, 8],
        "in_ring": [0, 1, 2, 3, 4, 5, 6, 7]
      },
      "expected": {
        "out_ring": [0, 1, 2, 3, 4, 5, 6, 7],
        "response": [0]
      }
    },
    {
      "name": "read middle cell",
      "inputs": {
        "request": [5, 3],
        "in_ring": [0, 1, 2, 3, 4, 5, 6, 7]
      },
      "expected": {
        "out_ring": [0, 1, 2, 3, 4, 5, 6, 7],
        "response": [5]
      }
    },
    {
      "name": "read last cell",
      "inputs": {
        "request": [7, 1],
        "in_ring": [0, 1, 2, 3, 4, 5, 6, 7]
      },
      "expected": {
        "out_ring": [0, 1, 2, 3, 4, 5, 6, 7],
        "response": [7]
      }
    },
    {
      "name": "write middle cell",
      "inputs": {
        "request": [5, -3, -7],
        "in_ring": [0, 1, 2, 3, 4, 5, 6, 7]
      },
      "expected": {
        "out_ring": [0, 1, 2, 3, 4, -7, 6, 7],
        "response": []
      }
    },
    {
      "name": "persistent loopback",
      "inputs": {
        "request": [0, 8, 5, -3, -7, 5, 3],
        "in_ring": [0, 1, 2, 3, 4, 5, 6, 7]
      },
      "loopbacks": {
        "out_ring": "in_ring"
      },
      "expected": {
        "response": [0, -7]
      }
    }
  ]
}
