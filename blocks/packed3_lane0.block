{
  "name": "Packed three-cell word codec, lane zero",
  "size": "44x7",
  "interior": [
    "v                                 s}{W`34`M<",
    "v                                          ^",
    "v                                          ^",
    ">>@rXr                                   s ^",
    " ^  v                                      ",
    " ^  >rs`2097151`NM1W-Mr&srM`2097151`W&Mr|s v",
    " ^                                         <"
  ],
  "ports": {
    "request": {
      "type": "input",
      "side": "top",
      "offset_range": [4, 4],
      "length_range": [2, 64]
    },
    "value": {
      "type": "input",
      "side": "bottom",
      "offset_range": [27, 27],
      "length_range": [2, 64]
    },
    "scratch_word_in": {
      "type": "input",
      "side": "bottom",
      "offset_range": [21, 21],
      "length_range": [2, 64]
    },
    "scratch_cleared_in": {
      "type": "input",
      "side": "bottom",
      "offset_range": [35, 35],
      "length_range": [2, 64]
    },
    "replacement": {
      "type": "output",
      "side": "right",
      "offset_range": [3, 3],
      "length_range": [2, 64]
    },
    "response": {
      "type": "output",
      "side": "top",
      "offset_range": [34, 34],
      "length_range": [2, 64]
    },
    "scratch_word_out": {
      "type": "output",
      "side": "bottom",
      "offset_range": [14, 14],
      "length_range": [2, 64]
    },
    "scratch_cleared_out": {
      "type": "output",
      "side": "bottom",
      "offset_range": [31, 31],
      "length_range": [2, 64]
    }
  },
  "tests": [
    {
      "name": "read negative lane zero",
      "inputs": {
        "request": [0, 2097145]
      },
      "expected": {
        "replacement": [2097145],
        "response": [-7],
        "scratch_word_out": [],
        "scratch_cleared_out": []
      }
    },
    {
      "name": "write lane zero preserving upper lanes",
      "inputs": {
        "request": [1, 88080384],
        "value": [-7]
      },
      "loopbacks": {
        "scratch_word_out": "scratch_word_in",
        "scratch_cleared_out": "scratch_cleared_in"
      },
      "expected": {
        "replacement": [90177529],
        "response": []
      }
    },
    {
      "name": "read maximum lane zero",
      "inputs": {
        "request": [0, 1000000]
      },
      "expected": {
        "replacement": [1000000],
        "response": [1000000],
        "scratch_word_out": [],
        "scratch_cleared_out": []
      }
    }
  ]
}
