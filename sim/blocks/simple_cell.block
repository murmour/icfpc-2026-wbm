{
  "name": "Simple one-word memory cell",
  "size": "5x3",
  "interior": [
    ">@rXv",
    "^Mr<W",
    "^ sM<"
  ],
  "ports": {
    "request": {
      "type": "input",
      "side": "top",
      "offset_range": [1, 1],
      "length_range": [2, 128]
    },
    "response": {
      "type": "output",
      "side": "top",
      "offset_range": [3, 3],
      "length_range": [2, 128]
    }
  },
  "tests": [
    {
      "name": "reads, writes, overwrite, and repeated read",
      "inputs": {
        "request": [0, 1, 42, 0, 1, -17, 0, 0]
      },
      "expected": {
        "response": [0, 42, -17, -17]
      }
    }
  ]
}
