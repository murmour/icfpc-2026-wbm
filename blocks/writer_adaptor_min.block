{
  "name": "Writer Adaptor Minimal",
  "size": "11x2",
  "interior": [
    ">@rM`32`W{v",
    "^<<<<<s+rM<"
  ],
  "ports": {
    "in_pair": {
      "type": "input",
      "side": "top",
      "offset_range": [2, 10],
      "length_range": [2, 64]
    },
    "out_storage": {
      "type": "output",
      "side": "bottom",
      "offset_range": [4, 7],
      "length_range": [2, 200]
    }
  },
  "tests": [
    {
      "name": "packs address and value",
      "inputs": {
        "in_pair": [1, 100, 2, -5]
      },
      "expected": {
        "out_storage": [4294967396, 8589934587]
      }
    }
  ]
}
