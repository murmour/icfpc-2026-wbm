{
  "name": "200-value unpacked associative memory controller",
  "size": "20x20",
  "interior": [
    "                    ",
    "                    ",
    "                    ",
    "       v     \u003c      ",
    "      vr\u003c           ",
    "       q     r      ",
    "       ]Xv   M      ",
    "       W~~   r      ",
    "       sms          ",
    "       Wrr      \u003ev  ",
    "      \u003es\u003es@rNXv\u003crM\u003ev",
    "      \u003ed^d\u003c    d^v  ",
    "       \u003ev\u003c^s0\u003e\u003csd]q\u003c",
    "       ^^ ^    r r  ",
    "               s m  ",
    "               ~ ~  ",
    "               ^ X  ",
    "          ^ Srs~ \u003c  ",
    "                    ",
    "                    "
  ],
  "ports": {
    "request": {
      "type": "input",
      "side": "right",
      "offset_range": [
        10,
        10
      ],
      "length_range": [
        2,
        64
      ]
    },
    "response": {
      "type": "output",
      "side": "bottom",
      "offset_range": [
        11,
        11
      ],
      "length_range": [
        2,
        64
      ]
    },
    "storage_in": {
      "type": "input",
      "side": "right",
      "offset_range": [
        13,
        13
      ],
      "length_range": [
        200,
        400
      ]
    },
    "storage_out": {
      "type": "output",
      "side": "right",
      "offset_range": [
        14,
        14
      ],
      "length_range": [
        2,
        16
      ]
    }
  },
  "tests": [
    {
      "name": "reads, writes, overwrites, and preserves negative values",
      "inputs": {
        "request": [
          0,
          3,
          1,
          7,
          42,
          0,
          7,
          1,
          7,
          -5,
          0,
          7,
          0,
          8
        ]
      },
      "expected": {
        "response": [
          0,
          42,
          -5,
          0
        ]
      },
      "loopbacks": {
        "storage_out": "storage_in"
      }
    }
  ]
}
